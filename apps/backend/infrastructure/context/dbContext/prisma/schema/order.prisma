model Order {
  id         String   @id @unique
  userId     String
  status     String
  isActive   Boolean @default(true)
  companyName String?
  address     String?
  apartment   String?
  postalCode  String?
  country     String?
  city        String?
  description String?
  quantity    Int
  deliversAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  payments  Payment[]
}