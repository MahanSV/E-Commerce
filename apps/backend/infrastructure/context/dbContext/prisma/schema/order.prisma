model Order {
  id          String   @id @default(uuid())
  userId      String
  status      String
  isActive    Boolean  @default(true)
  companyName String?
  address     String?
  apartment   String?
  postalCode  String?
  country     String?
  city        String?
  description String?
  total       Int
  deliversAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Int // قیمت لحظه ثبت سفارش (چون قیمت محصول اصلی ممکن است تغییر کند)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
