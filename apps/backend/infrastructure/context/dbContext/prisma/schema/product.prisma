model Category {
  id   String  @id @default(uuid())
  name String
  icon String?

  products Product[]
}

model Product {
  id           String  @id @default(uuid())
  categoryId   String
  title        String
  slug         String
  manufacturer String
  photo        Json?
  inStock      Boolean @default(false)
  price        Int     @default(0)
  rating       Int     @default(0)
  quantity     Int
  SKU          String?
  socialLink   String?
  description  String?
  information  String?

  wishlists        WishList[]
  merchantProducts MerchantProduct[]
  category         Category          @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
}
